{
  "schemaVersion": 1,
  "id": "minecraftgit",
  "version": "${version}",
  "name": "Minecraft Git",
  "description": "Client-side version control for Minecraft builds. Capture named selections, commit them to a real Git repository, and move builds between worlds.",
  "authors": [
    "Mustafa Faheem"
  ],
  "contact": {
    "homepage": "https://github.com/mustafa-5500/Minecraft-Git-Mod",
    "sources": "https://github.com/mustafa-5500/Minecraft-Git-Mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/minecraftgit/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.almond.minecraftgit.client.MinecraftGitClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
