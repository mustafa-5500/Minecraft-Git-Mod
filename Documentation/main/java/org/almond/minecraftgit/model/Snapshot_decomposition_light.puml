@startuml

'
' Light theme
'

'
' Colors
'
!$color_bg = "#FFFFFF"
!$color_fg = "#000000"
!$color_arrow = "#6b7280"

!$color_primary = "#333333"
!$color_sydd_bg = "#f0f7ff"
!$color_sydd_border = "#a9baccff"
!$color_sydd_main_border = "#2b6cb0"

!$color_srs_bg = "#fffbea"
!$color_srs_border = "#b7791f"

!$color_component_bg = "#e2e8f0"
!$color_component_border = "#4a5568"
!$color_external_component_bg = "#8eb2c0"
!$color_external_component_border = "#355360"

skinparam {
  BackgroundColor $color_bg

  DefaultFontName "Segoe UI"
  DefaultFontColor $color_fg

  ArrowColor $color_arrow
  ArrowFontSize 10
  ArrowFontStyle bold

  RectangleBackgroundColor $color_bg
  RectangleBorderColor $color_primary
  RectangleBorderThickness 2

  ComponentBackgroundColor $color_sydd_bg
  ComponentBorderColor $color_sydd_main_border
  ComponentBorderThickness 2

  ComponentStereotypeFontColor $color_fg
  Shadowing false
}

skinparam rectangle<<ZC>> {
  BackgroundColor $color_bg
  BorderColor $color_primary
  BorderThickness 2
}

skinparam rectangle<<SyDD>> {
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_border
  BorderThickness 2
  BorderStyle dashed
}

skinparam rectangle<<SyDDMain>> {
  FontStyle plain
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_main_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRS>> {
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRSMain>> {
  FontStyle plain
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam component<<External>> {
  BackgroundColor $color_external_component_bg
  BorderColor $color_external_component_border
  BorderThickness 2
  BorderStyle dashed
}


skinparam rectangle<<FileLevel>> {
  BackgroundColor #dbeafe
  BorderColor #2b6cb0
  BorderThickness 2
}
skinparam rectangle<<ClassLevel>> {
  BackgroundColor #eff6ff
  BorderColor #5b7fb6
  BorderThickness 1
}
skinparam component<<FunctionLevel>> {
  BackgroundColor #f8fbff
  BorderColor #6b8bbd
  BorderThickness 1
}

hide stereotype
left to right direction
title Function Call Decomposition: main/java/org/almond/minecraftgit/model/Snapshot.java
skinparam packageStyle rectangle

rectangle "Snapshot.java" <<FileLevel>> as file_Snapshot {
  rectangle "Top-Level Functions" <<ClassLevel>> as globals_Snapshot {
    component "Snapshot.java::<b>Snapshot()</b>" <<FunctionLevel>> as m_1
    component "Snapshot.java::<b>blockCount()</b>" <<FunctionLevel>> as m_2
    component "Snapshot.java::<b>blocks()</b>" <<FunctionLevel>> as m_3
    component "Snapshot.java::<b>byAbsolute()</b>" <<FunctionLevel>> as m_4
    component "Snapshot.java::<b>byRelative()</b>" <<FunctionLevel>> as m_5
    component "Snapshot.java::<b>capturedAt()</b>" <<FunctionLevel>> as m_6
    component "Snapshot.java::<b>dimensions()</b>" <<FunctionLevel>> as m_7
    component "Snapshot.java::<b>empty()</b>" <<FunctionLevel>> as m_8
    component "Snapshot.java::<b>entities()</b>" <<FunctionLevel>> as m_9
    component "Snapshot.java::<b>entityCount()</b>" <<FunctionLevel>> as m_10
    component "Snapshot.java::<b>isEmpty()</b>" <<FunctionLevel>> as m_11
    component "Snapshot.java::<b>origin()</b>" <<FunctionLevel>> as m_12
    component "Snapshot.java::<b>rebase()</b>" <<FunctionLevel>> as m_13
    component "Snapshot.java::<b>retain()</b>" <<FunctionLevel>> as m_14
    component "Snapshot.java::<b>selection()</b>" <<FunctionLevel>> as m_15
    component "Snapshot.java::<b>toString()</b>" <<FunctionLevel>> as m_16
    component "Snapshot.java::<b>volume()</b>" <<FunctionLevel>> as m_17
  }
}

cloud "BlockSnapshot()" as ext_6
cloud "EntitySnapshot()" as ext_7
cloud "absolute()" as ext_2
cloud "add()" as ext_5
cloud "contains()" as ext_8
cloud "name()" as ext_9
cloud "of()" as ext_1
cloud "relative()" as ext_3
cloud "subtract()" as ext_4

m_1 --> ext_1
m_4 --> ext_2
m_5 --> ext_3
m_7 <--> m_11
m_8 --> m_1
m_8 --> ext_1
m_11 <--> m_11
m_13 --> ext_2
m_13 --> ext_4
m_13 --> ext_5
m_13 --> ext_6
m_13 --> ext_7
m_13 --> m_1
m_14 --> ext_8
m_14 --> ext_2
m_14 --> ext_5
m_14 --> m_1
m_14 --> ext_9
m_14 <--> m_12
@enduml
