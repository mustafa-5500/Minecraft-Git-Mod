@startuml

'
' Light theme
'

'
' Colors
'
!$color_bg = "#FFFFFF"
!$color_fg = "#000000"
!$color_arrow = "#6b7280"

!$color_primary = "#333333"
!$color_sydd_bg = "#f0f7ff"
!$color_sydd_border = "#a9baccff"
!$color_sydd_main_border = "#2b6cb0"

!$color_srs_bg = "#fffbea"
!$color_srs_border = "#b7791f"

!$color_component_bg = "#e2e8f0"
!$color_component_border = "#4a5568"
!$color_external_component_bg = "#8eb2c0"
!$color_external_component_border = "#355360"

skinparam {
  BackgroundColor $color_bg

  DefaultFontName "Segoe UI"
  DefaultFontColor $color_fg

  ArrowColor $color_arrow
  ArrowFontSize 10
  ArrowFontStyle bold

  RectangleBackgroundColor $color_bg
  RectangleBorderColor $color_primary
  RectangleBorderThickness 2

  ComponentBackgroundColor $color_sydd_bg
  ComponentBorderColor $color_sydd_main_border
  ComponentBorderThickness 2

  ComponentStereotypeFontColor $color_fg
  Shadowing false
}

skinparam rectangle<<ZC>> {
  BackgroundColor $color_bg
  BorderColor $color_primary
  BorderThickness 2
}

skinparam rectangle<<SyDD>> {
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_border
  BorderThickness 2
  BorderStyle dashed
}

skinparam rectangle<<SyDDMain>> {
  FontStyle plain
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_main_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRS>> {
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRSMain>> {
  FontStyle plain
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam component<<External>> {
  BackgroundColor $color_external_component_bg
  BorderColor $color_external_component_border
  BorderThickness 2
  BorderStyle dashed
}


skinparam rectangle<<FileLevel>> {
  BackgroundColor #dbeafe
  BorderColor #2b6cb0
  BorderThickness 2
}
skinparam rectangle<<ClassLevel>> {
  BackgroundColor #eff6ff
  BorderColor #5b7fb6
  BorderThickness 1
}
skinparam component<<FunctionLevel>> {
  BackgroundColor #f8fbff
  BorderColor #6b8bbd
  BorderThickness 1
}

hide stereotype
left to right direction
title Function Call Decomposition: main/java/org/almond/minecraftgit/model/Cuboid.java
skinparam packageStyle rectangle

rectangle "Cuboid.java" <<FileLevel>> as file_Cuboid {
  rectangle "Top-Level Functions" <<ClassLevel>> as globals_Cuboid {
    component "Cuboid.java::<b>Cuboid()</b>" <<FunctionLevel>> as m_1
    component "Cuboid.java::<b>contains()</b>" <<FunctionLevel>> as m_2
    component "Cuboid.java::<b>corners()</b>" <<FunctionLevel>> as m_3
    component "Cuboid.java::<b>dimensions()</b>" <<FunctionLevel>> as m_4
    component "Cuboid.java::<b>expand()</b>" <<FunctionLevel>> as m_5
    component "Cuboid.java::<b>intersects()</b>" <<FunctionLevel>> as m_6
    component "Cuboid.java::<b>largestCorner()</b>" <<FunctionLevel>> as m_7
    component "Cuboid.java::<b>of()</b>" <<FunctionLevel>> as m_8
    component "Cuboid.java::<b>sizeX()</b>" <<FunctionLevel>> as m_9
    component "Cuboid.java::<b>sizeY()</b>" <<FunctionLevel>> as m_10
    component "Cuboid.java::<b>sizeZ()</b>" <<FunctionLevel>> as m_11
    component "Cuboid.java::<b>smallestCorner()</b>" <<FunctionLevel>> as m_12
    component "Cuboid.java::<b>toString()</b>" <<FunctionLevel>> as m_13
    component "Cuboid.java::<b>union()</b>" <<FunctionLevel>> as m_14
    component "Cuboid.java::<b>volume()</b>" <<FunctionLevel>> as m_15
  }
}

m_1 <--> m_8
m_1 <--> m_1
m_1 <--> m_12
m_1 <--> m_7
m_1 <--> m_9
m_1 <--> m_10
m_1 <--> m_11
m_1 <--> m_15
m_1 <--> m_2
m_1 <--> m_6
m_1 <--> m_14
m_1 <--> m_5
m_1 <--> m_3
m_1 <--> m_4
m_1 <--> m_13
m_3 <--> m_8
m_4 <--> m_9
m_4 <--> m_10
m_4 <--> m_11
m_5 <--> m_1
m_8 <--> m_1
m_14 <--> m_1
@enduml
