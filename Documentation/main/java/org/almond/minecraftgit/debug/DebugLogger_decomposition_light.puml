@startuml

'
' Light theme
'

'
' Colors
'
!$color_bg = "#FFFFFF"
!$color_fg = "#000000"
!$color_arrow = "#6b7280"

!$color_primary = "#333333"
!$color_sydd_bg = "#f0f7ff"
!$color_sydd_border = "#a9baccff"
!$color_sydd_main_border = "#2b6cb0"

!$color_srs_bg = "#fffbea"
!$color_srs_border = "#b7791f"

!$color_component_bg = "#e2e8f0"
!$color_component_border = "#4a5568"
!$color_external_component_bg = "#8eb2c0"
!$color_external_component_border = "#355360"

skinparam {
  BackgroundColor $color_bg

  DefaultFontName "Segoe UI"
  DefaultFontColor $color_fg

  ArrowColor $color_arrow
  ArrowFontSize 10
  ArrowFontStyle bold

  RectangleBackgroundColor $color_bg
  RectangleBorderColor $color_primary
  RectangleBorderThickness 2

  ComponentBackgroundColor $color_sydd_bg
  ComponentBorderColor $color_sydd_main_border
  ComponentBorderThickness 2

  ComponentStereotypeFontColor $color_fg
  Shadowing false
}

skinparam rectangle<<ZC>> {
  BackgroundColor $color_bg
  BorderColor $color_primary
  BorderThickness 2
}

skinparam rectangle<<SyDD>> {
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_border
  BorderThickness 2
  BorderStyle dashed
}

skinparam rectangle<<SyDDMain>> {
  FontStyle plain
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_main_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRS>> {
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRSMain>> {
  FontStyle plain
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam component<<External>> {
  BackgroundColor $color_external_component_bg
  BorderColor $color_external_component_border
  BorderThickness 2
  BorderStyle dashed
}


skinparam rectangle<<FileLevel>> {
  BackgroundColor #dbeafe
  BorderColor #2b6cb0
  BorderThickness 2
}
skinparam rectangle<<ClassLevel>> {
  BackgroundColor #eff6ff
  BorderColor #5b7fb6
  BorderThickness 1
}
skinparam component<<FunctionLevel>> {
  BackgroundColor #f8fbff
  BorderColor #6b8bbd
  BorderThickness 1
}

hide stereotype
left to right direction
title Function Call Decomposition: main/java/org/almond/minecraftgit/debug/DebugLogger.java
skinparam packageStyle rectangle

rectangle "DebugLogger.java" <<FileLevel>> as file_DebugLogger {
  rectangle "Top-Level Functions" <<ClassLevel>> as globals_DebugLogger {
    component "DebugLogger.java::<b>DebugLogger()</b>" <<FunctionLevel>> as m_1
    component "DebugLogger.java::<b>blockRead()</b>" <<FunctionLevel>> as m_2
    component "DebugLogger.java::<b>blockWrite()</b>" <<FunctionLevel>> as m_3
    component "DebugLogger.java::<b>close()</b>" <<FunctionLevel>> as m_4
    component "DebugLogger.java::<b>enabled()</b>" <<FunctionLevel>> as m_5
    component "DebugLogger.java::<b>file()</b>" <<FunctionLevel>> as m_6
    component "DebugLogger.java::<b>log()</b>" <<FunctionLevel>> as m_7
    component "DebugLogger.java::<b>setBlocks()</b>" <<FunctionLevel>> as m_8
    component "DebugLogger.java::<b>setEnabled()</b>" <<FunctionLevel>> as m_9
  }
}

cloud "format()" as ext_3
cloud "resolve()" as ext_1
cloud "warn()" as ext_4
cloud "write()" as ext_2

m_1 --> ext_1
m_2 --> m_7
m_3 --> m_7
m_4 --> m_4
m_7 --> ext_2
m_7 --> ext_3
m_7 --> ext_4
@enduml
