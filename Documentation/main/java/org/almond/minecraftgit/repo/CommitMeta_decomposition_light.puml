@startuml

'
' Light theme
'

'
' Colors
'
!$color_bg = "#FFFFFF"
!$color_fg = "#000000"
!$color_arrow = "#6b7280"

!$color_primary = "#333333"
!$color_sydd_bg = "#f0f7ff"
!$color_sydd_border = "#a9baccff"
!$color_sydd_main_border = "#2b6cb0"

!$color_srs_bg = "#fffbea"
!$color_srs_border = "#b7791f"

!$color_component_bg = "#e2e8f0"
!$color_component_border = "#4a5568"
!$color_external_component_bg = "#8eb2c0"
!$color_external_component_border = "#355360"

skinparam {
  BackgroundColor $color_bg

  DefaultFontName "Segoe UI"
  DefaultFontColor $color_fg

  ArrowColor $color_arrow
  ArrowFontSize 10
  ArrowFontStyle bold

  RectangleBackgroundColor $color_bg
  RectangleBorderColor $color_primary
  RectangleBorderThickness 2

  ComponentBackgroundColor $color_sydd_bg
  ComponentBorderColor $color_sydd_main_border
  ComponentBorderThickness 2

  ComponentStereotypeFontColor $color_fg
  Shadowing false
}

skinparam rectangle<<ZC>> {
  BackgroundColor $color_bg
  BorderColor $color_primary
  BorderThickness 2
}

skinparam rectangle<<SyDD>> {
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_border
  BorderThickness 2
  BorderStyle dashed
}

skinparam rectangle<<SyDDMain>> {
  FontStyle plain
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_main_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRS>> {
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRSMain>> {
  FontStyle plain
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam component<<External>> {
  BackgroundColor $color_external_component_bg
  BorderColor $color_external_component_border
  BorderThickness 2
  BorderStyle dashed
}


skinparam rectangle<<FileLevel>> {
  BackgroundColor #dbeafe
  BorderColor #2b6cb0
  BorderThickness 2
}
skinparam rectangle<<ClassLevel>> {
  BackgroundColor #eff6ff
  BorderColor #5b7fb6
  BorderThickness 1
}
skinparam component<<FunctionLevel>> {
  BackgroundColor #f8fbff
  BorderColor #6b8bbd
  BorderThickness 1
}

hide stereotype
left to right direction
title Function Call Decomposition: main/java/org/almond/minecraftgit/repo/CommitMeta.java
skinparam packageStyle rectangle

rectangle "CommitMeta.java" <<FileLevel>> as file_CommitMeta {
  rectangle "Top-Level Functions" <<ClassLevel>> as globals_CommitMeta {
    component "CommitMeta.java::<b>CommitMeta()</b>" <<FunctionLevel>> as m_1
    component "CommitMeta.java::<b>read()</b>" <<FunctionLevel>> as m_2
    component "CommitMeta.java::<b>toJson()</b>" <<FunctionLevel>> as m_3
    component "CommitMeta.java::<b>write()</b>" <<FunctionLevel>> as m_4
  }
}

cloud "RepoException()" as ext_5
cloud "create()" as ext_1
cloud "empty()" as ext_6
cloud "of()" as ext_2
cloud "readString()" as ext_7
cloud "toString()" as ext_3
cloud "writeString()" as ext_4

m_1 --> ext_1
m_1 --> ext_2
m_1 --> ext_3
m_1 --> m_4
m_1 --> ext_4
m_1 <--> m_3
m_1 --> ext_5
m_1 <--> m_2
m_1 --> ext_6
m_1 --> ext_7
m_2 --> ext_6
m_2 --> ext_7
m_2 --> ext_5
m_3 <--> m_3
m_4 --> ext_4
m_4 <--> m_3
m_4 --> ext_5
@enduml
