@startuml

'
' Light theme
'

'
' Colors
'
!$color_bg = "#FFFFFF"
!$color_fg = "#000000"
!$color_arrow = "#6b7280"

!$color_primary = "#333333"
!$color_sydd_bg = "#f0f7ff"
!$color_sydd_border = "#a9baccff"
!$color_sydd_main_border = "#2b6cb0"

!$color_srs_bg = "#fffbea"
!$color_srs_border = "#b7791f"

!$color_component_bg = "#e2e8f0"
!$color_component_border = "#4a5568"
!$color_external_component_bg = "#8eb2c0"
!$color_external_component_border = "#355360"

skinparam {
  BackgroundColor $color_bg

  DefaultFontName "Segoe UI"
  DefaultFontColor $color_fg

  ArrowColor $color_arrow
  ArrowFontSize 10
  ArrowFontStyle bold

  RectangleBackgroundColor $color_bg
  RectangleBorderColor $color_primary
  RectangleBorderThickness 2

  ComponentBackgroundColor $color_sydd_bg
  ComponentBorderColor $color_sydd_main_border
  ComponentBorderThickness 2

  ComponentStereotypeFontColor $color_fg
  Shadowing false
}

skinparam rectangle<<ZC>> {
  BackgroundColor $color_bg
  BorderColor $color_primary
  BorderThickness 2
}

skinparam rectangle<<SyDD>> {
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_border
  BorderThickness 2
  BorderStyle dashed
}

skinparam rectangle<<SyDDMain>> {
  FontStyle plain
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_main_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRS>> {
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRSMain>> {
  FontStyle plain
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam component<<External>> {
  BackgroundColor $color_external_component_bg
  BorderColor $color_external_component_border
  BorderThickness 2
  BorderStyle dashed
}


skinparam rectangle<<FileLevel>> {
  BackgroundColor #dbeafe
  BorderColor #2b6cb0
  BorderThickness 2
}
skinparam rectangle<<ClassLevel>> {
  BackgroundColor #eff6ff
  BorderColor #5b7fb6
  BorderThickness 1
}
skinparam component<<FunctionLevel>> {
  BackgroundColor #f8fbff
  BorderColor #6b8bbd
  BorderThickness 1
}

hide stereotype
left to right direction
title Function Call Decomposition: main/java/org/almond/minecraftgit/config/ModConfig.java
skinparam packageStyle rectangle

rectangle "ModConfig.java" <<FileLevel>> as file_ModConfig {
  rectangle "Top-Level Functions" <<ClassLevel>> as globals_ModConfig {
    component "ModConfig.java::<b>ModConfig()</b>" <<FunctionLevel>> as m_1
    component "ModConfig.java::<b>backupsRoot()</b>" <<FunctionLevel>> as m_2
    component "ModConfig.java::<b>file()</b>" <<FunctionLevel>> as m_3
    component "ModConfig.java::<b>load()</b>" <<FunctionLevel>> as m_4
    component "ModConfig.java::<b>logsRoot()</b>" <<FunctionLevel>> as m_5
    component "ModConfig.java::<b>metaRoot()</b>" <<FunctionLevel>> as m_6
    component "ModConfig.java::<b>nonBlank()</b>" <<FunctionLevel>> as m_7
    component "ModConfig.java::<b>normalize()</b>" <<FunctionLevel>> as m_8
    component "ModConfig.java::<b>positive()</b>" <<FunctionLevel>> as m_9
    component "ModConfig.java::<b>reposRoot()</b>" <<FunctionLevel>> as m_10
    component "ModConfig.java::<b>root()</b>" <<FunctionLevel>> as m_11
    component "ModConfig.java::<b>save()</b>" <<FunctionLevel>> as m_12
    component "ModConfig.java::<b>selectionsRoot()</b>" <<FunctionLevel>> as m_13
    component "ModConfig.java::<b>stagingRoot()</b>" <<FunctionLevel>> as m_14
    component "ModConfig.java::<b>tmpRoot()</b>" <<FunctionLevel>> as m_15
  }
}

cloud "create()" as ext_2
cloud "readString()" as ext_3
cloud "resolve()" as ext_1
cloud "toJson()" as ext_6
cloud "warn()" as ext_4
cloud "writeString()" as ext_5

m_2 --> ext_1
m_3 --> ext_1
m_4 --> m_1
m_4 --> m_8
m_4 --> ext_2
m_4 <--> m_3
m_4 --> ext_3
m_4 --> m_12
m_4 --> ext_4
m_5 --> ext_1
m_6 --> ext_1
m_8 <--> m_7
m_8 <--> m_9
m_10 --> ext_1
m_12 <--> m_3
m_12 --> ext_5
m_12 --> ext_6
m_12 --> ext_4
m_13 --> ext_1
m_14 --> ext_1
m_15 --> ext_1
@enduml
