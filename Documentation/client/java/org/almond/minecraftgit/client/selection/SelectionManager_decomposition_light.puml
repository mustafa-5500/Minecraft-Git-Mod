@startuml

'
' Light theme
'

'
' Colors
'
!$color_bg = "#FFFFFF"
!$color_fg = "#000000"
!$color_arrow = "#6b7280"

!$color_primary = "#333333"
!$color_sydd_bg = "#f0f7ff"
!$color_sydd_border = "#a9baccff"
!$color_sydd_main_border = "#2b6cb0"

!$color_srs_bg = "#fffbea"
!$color_srs_border = "#b7791f"

!$color_component_bg = "#e2e8f0"
!$color_component_border = "#4a5568"
!$color_external_component_bg = "#8eb2c0"
!$color_external_component_border = "#355360"

skinparam {
  BackgroundColor $color_bg

  DefaultFontName "Segoe UI"
  DefaultFontColor $color_fg

  ArrowColor $color_arrow
  ArrowFontSize 10
  ArrowFontStyle bold

  RectangleBackgroundColor $color_bg
  RectangleBorderColor $color_primary
  RectangleBorderThickness 2

  ComponentBackgroundColor $color_sydd_bg
  ComponentBorderColor $color_sydd_main_border
  ComponentBorderThickness 2

  ComponentStereotypeFontColor $color_fg
  Shadowing false
}

skinparam rectangle<<ZC>> {
  BackgroundColor $color_bg
  BorderColor $color_primary
  BorderThickness 2
}

skinparam rectangle<<SyDD>> {
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_border
  BorderThickness 2
  BorderStyle dashed
}

skinparam rectangle<<SyDDMain>> {
  FontStyle plain
  BackgroundColor $color_sydd_bg
  BorderColor $color_sydd_main_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRS>> {
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam rectangle<<SRSMain>> {
  FontStyle plain
  BackgroundColor $color_srs_bg
  BorderColor $color_srs_border
  BorderThickness 2
  BorderStyle solid
}

skinparam component<<External>> {
  BackgroundColor $color_external_component_bg
  BorderColor $color_external_component_border
  BorderThickness 2
  BorderStyle dashed
}


skinparam rectangle<<FileLevel>> {
  BackgroundColor #dbeafe
  BorderColor #2b6cb0
  BorderThickness 2
}
skinparam rectangle<<ClassLevel>> {
  BackgroundColor #eff6ff
  BorderColor #5b7fb6
  BorderThickness 1
}
skinparam component<<FunctionLevel>> {
  BackgroundColor #f8fbff
  BorderColor #6b8bbd
  BorderThickness 1
}

hide stereotype
left to right direction
title Function Call Decomposition: client/java/org/almond/minecraftgit/client/selection/SelectionManager.java
skinparam packageStyle rectangle

rectangle "SelectionManager.java" <<FileLevel>> as file_SelectionManager {
  rectangle "Top-Level Functions" <<ClassLevel>> as globals_SelectionManager {
    component "SelectionManager.java::<b>SelectionManager()</b>" <<FunctionLevel>> as m_1
    component "SelectionManager.java::<b>active()</b>" <<FunctionLevel>> as m_2
    component "SelectionManager.java::<b>clear()</b>" <<FunctionLevel>> as m_3
    component "SelectionManager.java::<b>cornerA()</b>" <<FunctionLevel>> as m_4
    component "SelectionManager.java::<b>cornerB()</b>" <<FunctionLevel>> as m_5
    component "SelectionManager.java::<b>peekPending()</b>" <<FunctionLevel>> as m_6
    component "SelectionManager.java::<b>pendingCuboid()</b>" <<FunctionLevel>> as m_7
    component "SelectionManager.java::<b>session()</b>" <<FunctionLevel>> as m_8
    component "SelectionManager.java::<b>setActive()</b>" <<FunctionLevel>> as m_9
    component "SelectionManager.java::<b>setCorner()</b>" <<FunctionLevel>> as m_10
    component "SelectionManager.java::<b>setPending()</b>" <<FunctionLevel>> as m_11
    component "SelectionManager.java::<b>takePending()</b>" <<FunctionLevel>> as m_12
  }
}

cloud "empty()" as ext_7
cloud "find()" as ext_3
cloud "id()" as ext_2
cloud "lastSelection()" as ext_1
cloud "of()" as ext_6
cloud "remove()" as ext_4
cloud "setLastSelection()" as ext_5

m_2 --> ext_1
m_2 --> ext_2
m_2 --> ext_3
m_3 --> ext_4
m_6 <--> m_8
m_9 --> ext_5
m_9 --> ext_2
m_10 <--> m_8
m_10 --> ext_6
m_10 --> ext_7
m_11 <--> m_8
m_12 <--> m_8
@enduml
